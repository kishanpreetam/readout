{
 "question": "Which German cities have the most recruiting phase 3 trials?",
 "sql": "SELECT s.city, s.geo_key, count(DISTINCT s.nct_id) AS recruiting_phase3_trials,\n       count(*) AS sites\nFROM marts.fct_trial_sites AS s\nJOIN marts.dim_trial AS t USING (nct_id)\nWHERE s.country = 'Germany'\n  AND t.overall_status = 'RECRUITING'\n  AND t.phase IN ('PHASE3', 'PHASE2_PHASE3')\n  AND s.geo_key IS NOT NULL\nGROUP BY s.city, s.geo_key\nORDER BY recruiting_phase3_trials DESC\nLIMIT 500",
